{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "sigmalang",
  "scopeName": "source.sigmalang",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.sigmalang",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.sigmalang",
          "match": "\"[^\"\\n]*\""
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.sigmalang",
          "match": "\\b(is_this_real|nah|exit|fr)\\b"
        },
        {
          "name": "storage.type.sigmalang",
          "match": "\\b(squad|lore)\\b"
        },
        {
          "name": "storage.modifier.sigmalang",
          "match": "\\b(canon|yap|canonmaxing)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.sigmalang",
          "match": "\\b(absorb|spit_fax)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.sigmalang",
          "match": "\\b(npc|sigma|take)\\b"
        },
        {
          "name": "entity.name.type.struct.sigmalang",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.sigmalang",
          "match": "\\b(hot|cringe)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.sigmalang",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.sigmalang",
          "match": "->"
        },
        {
          "name": "keyword.operator.assignment.sigmalang",
          "match": "(:=|👈🏻)"
        },
        {
          "name": "keyword.operator.comparison.sigmalang",
          "match": "(==|!=|🤝|💔)"
        },
        {
          "name": "keyword.operator.arithmetic.sigmalang",
          "match": "(\\+|\\-|\\*)"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.decimal.sigmalang",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.sigmalang",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
