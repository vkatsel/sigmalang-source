{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "sigmalang",
  "scopeName": "source.sigmalang",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.sigmalang",
          "match": "#.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.sigmalang",
          "match": "\\b(is_this_real|nah|exit)\\b"
        },
        {
          "name": "storage.modifier.sigmalang",
          "match": "\\b(canon|yap|canonmaxing)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.sigmalang",
          "match": "\\b(npc|sigma|take)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.sigmalang",
          "match": "\\b(hot|cringe)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.sigmalang",
          "match": "(:=|👈🏻)"
        },
        {
          "name": "keyword.operator.comparison.sigmalang",
          "match": "(==|!=|🤝|💔)"
        },
        {
          "name": "keyword.operator.arithmetic.sigmalang",
          "match": "(\\+|\\-|\\*)"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.decimal.sigmalang",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.sigmalang",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
