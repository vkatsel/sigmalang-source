{
  "Emoji Assignment Operator": {
    "prefix": ["assign", "hand", "<-", "point"],
    "body": ["👈🏻"],
    "description": "Insert emoji assignment operator 👈🏻"
  },
  "Emoji Equality Operator": {
    "prefix": ["eq", "shake", "agree"],
    "body": ["🤝"],
    "description": "Insert emoji equality operator 🤝"
  },
  "Emoji Inequality Operator": {
    "prefix": ["neq", "broken", "heartbreak"],
    "body": ["💔"],
    "description": "Insert emoji inequality operator 💔"
  },
  "Canon Constant Declaration": {
    "prefix": ["canon", "const"],
    "body": [
      "canon ${1|npc,sigma,take|} ${2:name} 👈🏻 ${3:value}"
    ],
    "description": "Declare an immutable compile-time constant"
  },
  "Yap Mutable Variable Declaration": {
    "prefix": ["yap", "mut", "var"],
    "body": [
      "yap ${1|npc,sigma,take|} ${2:name} 👈🏻 ${3:value}"
    ],
    "description": "Declare a mutable variable"
  },
  "Canonmaxing Immutable Declaration": {
    "prefix": ["canonmaxing", "let", "immut"],
    "body": [
      "canonmaxing ${1|npc,sigma,take|} ${2:name} 👈🏻 ${3:value}"
    ],
    "description": "Declare an immutable variable"
  },
  "Lore Function Definition": {
    "prefix": ["lore", "fn", "func"],
    "body": [
      "lore ${1:name}(${2:npc a}) -> ${3|npc,sigma,take|} {",
      "\t$0",
      "\texit ${4:0}",
      "}"
    ],
    "description": "Define a lore function or member function"
  },
  "Squad Structure Definition": {
    "prefix": ["squad", "struct"],
    "body": [
      "squad ${1:Name} {",
      "\tyap ${2|npc,sigma,take|} ${3:field}",
      "\t$0",
      "}"
    ],
    "description": "Define a squad structure with fields and optional member functions"
  },
  "Spit Fax (Print) Statement": {
    "prefix": ["spit_fax", "print"],
    "body": [
      "spit_fax(${1:value})"
    ],
    "description": "Print a value or string literal with trailing newline"
  },
  "Absorb (Read) Expression": {
    "prefix": ["absorb", "read"],
    "body": [
      "absorb()"
    ],
    "description": "Read a 32-bit integer (npc) from standard input"
  },
  "If Statement": {
    "prefix": ["if", "is_this_real"],
    "body": [
      "is_this_real ${1:condition} {",
      "\t$0",
      "}"
    ],
    "description": "Conditional if block"
  },
  "If-Else Statement": {
    "prefix": ["ifelse", "ifnah"],
    "body": [
      "is_this_real ${1:condition} {",
      "\t$2",
      "} nah {",
      "\t$0",
      "}"
    ],
    "description": "Conditional if-else block"
  },
  "Exit Statement": {
    "prefix": ["exit"],
    "body": [
      "exit ${1:0}"
    ],
    "description": "Exit function or program with a value"
  }
}
